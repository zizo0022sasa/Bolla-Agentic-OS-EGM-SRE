# Copy this file to .env and fill in your values. NEVER commit real secrets to Git.

BOLLA_ENV=development
BOLLA_LOG_LEVEL=INFO

# AI Provider API Keys (Optional - only required if using external LLM SDKs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
